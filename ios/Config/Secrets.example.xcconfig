// Copy to Config/Secrets.xcconfig (gitignored, never committed) and fill in the iOS OAuth client from
// Google Cloud Console (application type iOS, bundle id com.mido.stmp).
GOOGLE_IOS_CLIENT_ID = 000000000000-example.apps.googleusercontent.com
// The same client id with its two halves reversed, used as the URL scheme for the PKCE redirect.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-example
