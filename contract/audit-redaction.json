{
  "version": 1,
  "redactedValue": "[redacted]",
  "note": "Matching is STRICT on purpose: any key that merely contains a sensitive substring is redacted even when it is innocent (monkey, keyboard, author, design). A redacted benign value costs a little log detail; a leaked credential cannot be taken back from an append-only log. Values are never logged in any other form: no length, no prefix, no hash. Drops apply to headers only; query keys are never dropped.",
  "droppedHeaders": [
    "host",
    "content-length",
    "connection",
    "accept-encoding"
  ],
  "sensitiveKeySubstrings": [
    "token",
    "key",
    "secret",
    "auth",
    "session",
    "signature",
    "cookie",
    "password",
    "authorization",
    "proxyauthorization",
    "apikey",
    "accesstoken",
    "sig",
    "jwt",
    "bearer",
    "credential",
    "passwd",
    "pwd"
  ],
  "normalise": "lowercase the key, then remove every '-' and '_'; droppedHeaders are compared to the lower-cased key (separators kept); a key is sensitive when the normalised key contains any sensitiveKeySubstrings entry",
  "vectors": [
    {
